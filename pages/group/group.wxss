.group-page {
  padding-top: 20rpx;
}

.ride-card {
  padding: 28rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #084b3f, #0b6b58);
}

.ride-top,
.route-row,
.section-heading,
.member-card,
.member-name {
  display: flex;
  align-items: center;
}

.ride-top,
.route-row {
  justify-content: space-between;
}

.direction-tag,
.owner-badge,
.self-badge {
  padding: 6rpx 13rpx;
  border-radius: 99rpx;
  font-size: 19rpx;
}

.direction-tag {
  color: #075141;
  background: #9ce2c8;
}

.ride-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ride-status {
  padding: 6rpx 13rpx;
  border-radius: 99rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.status-seats {
  color: #075141;
  background: #9ce2c8;
}

.status-running {
  color: #7a3f1f;
  background: #ffd9b8;
}

.status-full,
.status-closed {
  color: #52645e;
  background: #e6eeea;
}

.ride-time,
.ride-meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.route-row {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.route-arrow {
  color: #9ce2c8;
}

.ride-meta {
  margin-top: 18rpx;
}

.leave-locked {
  margin-top: 18rpx;
  color: #9aa8a3;
  font-size: 22rpx;
  text-align: center;
}

.ride-note {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.09);
  font-size: 22rpx;
}


.settlement-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.settlement-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settlement-title {
  color: #18332d;
  font-size: 30rpx;
  font-weight: 700;
}

.settlement-status {
  padding: 6rpx 14rpx;
  border-radius: 99rpx;
  color: #a85f37;
  background: #fff3e4;
  font-size: 20rpx;
}

.settlement-summary {
  margin-top: 16rpx;
  color: #31554c;
  font-size: 24rpx;
  line-height: 1.6;
}

.settlement-progress {
  margin-top: 8rpx;
  color: #7c8d87;
  font-size: 21rpx;
}

.settlement-button {
  height: 72rpx;
  margin-top: 18rpx;
  color: #ffffff;
  background: #0b5c4d;
  font-size: 24rpx;
  line-height: 72rpx;
}

.external-trip-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.external-trip-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.external-trip-title-wrap {
  flex: 1;
  min-width: 0;
}

.external-trip-title {
  color: #18332d;
  font-size: 30rpx;
  font-weight: 700;
}

.external-trip-subtitle {
  margin-top: 6rpx;
  color: #7c8d87;
  font-size: 21rpx;
}

.external-trip-provider {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 99rpx;
  color: #0b6b58;
  background: #e5f5ef;
  font-size: 20rpx;
  font-weight: 600;
}

.external-trip-host {
  overflow: hidden;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #31554c;
  background: #f3f8f5;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.external-trip-note,
.external-trip-hint {
  margin-top: 14rpx;
  color: #7c8d87;
  font-size: 20rpx;
  line-height: 1.6;
}

.external-trip-empty {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #5f746d;
  background: #f6faf7;
  font-size: 22rpx;
  line-height: 1.6;
}

.external-trip-actions,
.external-trip-editor-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.external-trip-actions button,
.external-trip-editor-actions button {
  flex: 1;
  min-width: 170rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 72rpx;
}

.external-trip-primary {
  color: #ffffff;
  background: #0b5c4d;
}

.external-trip-secondary {
  color: #18332d;
  background: #f0f6f2;
}

.external-trip-danger {
  color: #b4442a;
  background: #fff0e8;
}

.external-trip-editor {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2ef;
}

.external-trip-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 126rpx;
  padding: 18rpx;
  border: 1rpx solid #dbe8e2;
  border-radius: 16rpx;
  color: #18332d;
  background: #fbfdfc;
  font-size: 23rpx;
  line-height: 1.5;
}

.error-card,
.join-card {
  margin-top: 20rpx;
  padding: 28rpx;
  text-align: center;
}

.error-card {
  color: #b65d35;
}

.join-title {
  font-size: 30rpx;
  font-weight: 700;
}

.join-caption {
  margin: 10rpx 0 22rpx;
  color: #71807b;
  font-size: 22rpx;
}

.join-button {
  color: #ffffff;
  background: #0b5c4d;
}

.section-heading {
  margin: 34rpx 4rpx 16rpx;
}

.section-title {
  margin: 0;
  font-size: 32rpx;
}

.member-count {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 99rpx;
  color: #0b6b58;
  background: #e5f5ef;
  font-size: 20rpx;
}

.member-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.member-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #e5f5ef;
}

.member-avatar-text {
  color: #ffffff;
  background: #0b6b58;
  line-height: 76rpx;
  text-align: center;
  font-weight: 700;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  gap: 8rpx;
  font-weight: 700;
}

.owner-badge {
  color: #a85f37;
  background: #fff0e7;
}

.self-badge {
  color: #0b6b58;
  background: #e5f5ef;
}

.member-detail,
.member-bio {
  overflow: hidden;
  margin-top: 6rpx;
  color: #7c8d87;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.buddy-button {
  flex: none;
  margin-left: 12rpx;
  padding: 0 18rpx;
  color: #ffffff;
  background: #0b5c4d;
}

.buddy-sent {
  color: #71807b;
  background: #e8eeeb;
}

.loading-state,
.safety-tip {
  padding: 36rpx 20rpx;
  color: #7c8d87;
  font-size: 22rpx;
  text-align: center;
}

.status-banner {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fff0e8;
  color: #b4442a;
  font-size: 24rpx;
  text-align: center;
}

.group-actions {
  margin-top: 24rpx;
  padding: 20rpx;
}

.chat-button {
  background: #075e54;
  color: #ffffff;
}

.owner-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.owner-actions .chat-button,
.owner-actions .secondary-button,
.owner-actions .danger-button {
  width: 100%;
  height: 66rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
  line-height: 66rpx;
}

.secondary-button,
.danger-button,
.danger-link,
.remove-button {
  background: #f4f7f5;
  color: #18332e;
  font-size: 24rpx;
}

.danger-button,
.danger-link,
.remove-button {
  color: #b4442a;
}

.danger-link {
  margin-top: 16rpx;
}

.member-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.remove-button {
  margin-top: 8rpx;
}

.safety-tip {
  padding-top: 26rpx;
  line-height: 1.6;
}
