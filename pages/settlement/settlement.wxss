.settlement-page {
  padding-top: 0;
}

.settlement-hero {
  margin: 0 -28rpx 20rpx;
  padding: 40rpx 32rpx 48rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #084b3f, #0b6b58 70%, #17846c);
}

.settlement-eyebrow {
  color: #9ce2c8;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.settlement-heading {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.settlement-subheading {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.form-card,
.member-select-card,
.estimate-card,
.summary-card,
.pay-card,
.owner-qr-card,
.participants-card,
.empty-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
}

.field-help {
  margin-top: 10rpx;
  color: #7c8d87;
  font-size: 21rpx;
  line-height: 1.6;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe8e2;
  border-radius: 16rpx;
  background: #f8faf9;
}

.amount-input-wrap text {
  color: #a85f37;
  font-size: 30rpx;
  font-weight: 700;
}

.amount-input {
  flex: 1;
  height: 86rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.select-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-count {
  color: #0b6b58;
  font-size: 21rpx;
}

.select-member {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e3ebe7;
  border-radius: 16rpx;
  background: #fbfdfc;
}

.select-member-active {
  border-color: #9ed9c4;
  background: #f0faf6;
}

.select-check {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #b9d8cd;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.select-member-active .select-check {
  border-color: #0b6b58;
  background: #0b6b58;
}

.select-member-info {
  flex: 1;
  min-width: 0;
}

.select-member-name {
  color: #18332d;
  font-size: 24rpx;
  font-weight: 600;
}

.select-self {
  margin-left: 8rpx;
  padding: 3rpx 9rpx;
  border-radius: 99rpx;
  color: #0b6b58;
  background: #e5f5ef;
  font-size: 18rpx;
  font-weight: 400;
}

.select-member-role {
  margin-top: 4rpx;
  color: #7c8d87;
  font-size: 20rpx;
}

.estimate-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.estimate-label {
  font-size: 26rpx;
  font-weight: 700;
}

.estimate-note {
  margin-top: 6rpx;
  color: #7c8d87;
  font-size: 20rpx;
}

.estimate-value {
  flex: none;
  color: #a85f37;
  font-size: 42rpx;
  font-weight: 750;
}

.estimate-value text {
  margin-left: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-label {
  color: #7c8d87;
  font-size: 23rpx;
}

.summary-value {
  color: #18332d;
  font-size: 28rpx;
  font-weight: 650;
}

.summary-accent {
  color: #a85f37;
}

.settlement-admin-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.admin-button {
  flex: 1;
  height: 66rpx;
  border-radius: 16rpx;
  color: #0b5c4d;
  background: #eaf7f3;
  font-size: 22rpx;
  line-height: 66rpx;
}

.admin-button-danger {
  color: #a85f37;
  background: #fff7f0;
}

.admin-hint {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #9a6a3a;
  background: #fff7f0;
  font-size: 20rpx;
  line-height: 1.55;
}

.reminder-button {
  height: 66rpx;
  margin-top: 12rpx;
  border: 1rpx solid #cfe6dc;
  border-radius: 16rpx;
  color: #0b5c4d;
  background: #f2faf6;
  font-size: 22rpx;
  line-height: 66rpx;
}

.cancel-edit-button {
  height: 66rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  color: #7c8d87;
  background: transparent;
  font-size: 22rpx;
  line-height: 66rpx;
}

.pay-label {
  color: #7c8d87;
  font-size: 23rpx;
}

.pay-amount {
  margin-top: 8rpx;
  color: #a85f37;
  font-size: 56rpx;
  font-weight: 750;
}

.pay-caption {
  margin-top: 6rpx;
  color: #31554c;
  font-size: 23rpx;
}

.pay-qr-wrap,
.owner-qr-wrap {
  margin-top: 20rpx;
  text-align: center;
}

.pay-qr,
.owner-qr {
  display: block;
  width: 340rpx;
  margin: 0 auto;
  border: 1rpx solid #e3ebe7;
  border-radius: 18rpx;
  background: #ffffff;
}

.owner-qr {
  width: 300rpx;
}

.pay-qr-tip {
  margin-top: 12rpx;
  color: #7c8d87;
  font-size: 20rpx;
  text-align: center;
}

.pay-qr-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  color: #9a6a3a;
  background: #fff7f0;
  font-size: 21rpx;
  line-height: 1.6;
}

.pay-status {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  color: #7c8d87;
  background: #f4f7f5;
  font-size: 22rpx;
  text-align: center;
}

.pay-status-claimed {
  color: #4d7197;
  background: #edf5fc;
}

.pay-status-confirmed {
  color: #0b6b58;
  background: #e5f5ef;
}

.pay-button,
.copy-amount-button {
  height: 78rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 78rpx;
}

.pay-button {
  color: #ffffff;
  background: #0b5c4d;
}

.pay-button-muted {
  color: #71807b;
  background: #e8eeeb;
}

.copy-amount-button {
  color: #18332d;
  background: #f0f6f2;
}

.pay-warning,
.complete-tip {
  margin-top: 14rpx;
  color: #7c8d87;
  font-size: 20rpx;
  line-height: 1.6;
}

.owner-qr-card {
  text-align: left;
}

.participants-card {
  padding-bottom: 8rpx;
}

.participant-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf2ef;
}

.participant-main {
  flex: 1;
  min-width: 0;
}

.participant-name {
  color: #18332d;
  font-size: 24rpx;
  font-weight: 600;
}

.participant-status {
  margin-top: 4rpx;
  color: #7c8d87;
  font-size: 20rpx;
}

.participant-status-claimed {
  color: #4d7197;
}

.participant-status-confirmed {
  color: #0b6b58;
}

.participant-share {
  flex: none;
  color: #a85f37;
  font-size: 26rpx;
  font-weight: 700;
}

.confirm-button {
  flex: none;
  margin: 0;
  padding: 0 16rpx;
  height: 58rpx;
  border-radius: 14rpx;
  color: #0b6b58;
  background: #e5f5ef;
  font-size: 21rpx;
  line-height: 58rpx;
}

.complete-button {
  margin-top: 22rpx;
}

.complete-button-disabled {
  color: #9aa8a3;
  background: #e8eeeb;
}

.empty-card {
  color: #7c8d87;
  font-size: 23rpx;
  text-align: center;
}

.loading-state,
.error-card {
  margin-top: 20rpx;
  padding: 36rpx 20rpx;
  color: #7c8d87;
  font-size: 23rpx;
  text-align: center;
}
