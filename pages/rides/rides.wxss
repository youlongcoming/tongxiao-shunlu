.rides-page {
  padding-top: 0;
}

.list-header {
  margin: 0 -28rpx;
  padding: 42rpx 36rpx 38rpx;
  color: #ffffff;
  background: #0b5c4d;
}

.list-title {
  font-size: 40rpx;
  font-weight: 700;
}

.list-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.match-card {
  margin-top: -20rpx;
  padding: 28rpx;
}

.match-heading,
.match-location-row,
.match-date-row {
  display: flex;
  align-items: center;
}

.match-heading {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.match-title {
  font-size: 31rpx;
  font-weight: 700;
}

.match-caption {
  margin-top: 5rpx;
  color: #83918c;
  font-size: 21rpx;
}

.clear-match {
  color: #0b6b58;
  font-size: 23rpx;
}

.match-route {
  position: relative;
}

.match-location-row {
  position: relative;
  align-items: flex-start;
}

.match-input-wrap {
  flex: 1;
  min-width: 0;
}

.match-dot {
  z-index: 1;
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin: 24rpx 22rpx 0 8rpx;
  border: 5rpx solid #0b6b58;
  border-radius: 50%;
  background: #ffffff;
}

.match-dot-end {
  border-color: #e06f3d;
}

.match-route-line {
  width: 2rpx;
  height: 18rpx;
  margin-left: 19rpx;
  background: #cddbd5;
}

.match-input {
  flex: 1;
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce7e2;
  border-radius: 14rpx;
  background: #f8faf9;
  font-size: 25rpx;
}

.location-suggestions {
  margin-top: 8rpx;
  overflow: hidden;
  border: 1rpx solid #dce7e2;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(13, 73, 60, 0.12);
}

.suggestions-caption {
  padding: 12rpx 20rpx;
  color: #8a9893;
  background: #f4f8f6;
  font-size: 19rpx;
}

.location-suggestion {
  padding: 18rpx 20rpx;
  border-top: 1rpx solid #eef4f1;
  color: #29433c;
  font-size: 24rpx;
}

.location-suggestion:active {
  background: #f1faf6;
}

.match-date-row {
  gap: 12rpx;
  margin-top: 22rpx;
}

.match-picker {
  flex: 1;
  min-width: 0;
}

.match-picker-value {
  box-sizing: border-box;
  min-height: 90rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid #dce7e2;
  border-radius: 14rpx;
  color: #29433c;
  background: #f8faf9;
  font-size: 23rpx;
  text-align: center;
}

.picker-label {
  margin-bottom: 5rpx;
  color: #83918c;
  font-size: 20rpx;
}

.match-button {
  box-sizing: border-box;
  height: 78rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  line-height: 76rpx;
  border: 1rpx solid #9cc9bc;
  border-radius: 18rpx;
  color: #075e54;
  background: #ffffff;
  font-weight: 600;
}

.match-button-pressed {
  border-color: #7eb6a6;
  color: #075e54;
  background: #edf6f3;
}

.match-summary {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: #0b5c4d;
  background: #e8f5f0;
  font-size: 22rpx;
  line-height: 1.5;
}

.filter-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.filters {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.filter-pill {
  flex: none;
  padding: 16rpx 30rpx;
  border: 1rpx solid #d9e5df;
  border-radius: 99rpx;
  color: #52645e;
  background: #ffffff;
}

.filter-active {
  color: #ffffff;
  border-color: #0b5c4d;
  background: #0b5c4d;
}

.result-count {
  margin: 28rpx 4rpx 18rpx;
  color: #71807b;
  font-size: 24rpx;
}

.ride-item {
  position: relative;
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.best-match {
  border: 2rpx solid #20a078;
  box-shadow: 0 14rpx 34rpx rgba(11, 107, 88, 0.13);
}

.best-match-badge {
  position: absolute;
  top: -2rpx;
  right: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 0 0 14rpx 14rpx;
  color: #ffffff;
  background: #20a078;
  font-size: 21rpx;
  font-weight: 650;
}

.ride-heading,
.ride-footer,
.owner-block,
.location-row {
  display: flex;
  align-items: center;
}

.ride-heading,
.ride-footer {
  justify-content: space-between;
}

.direction-tag {
  margin-right: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  color: #0b6b58;
  background: #e4f5ee;
  font-size: 22rpx;
  font-weight: 650;
}

.type-text {
  color: #71807b;
  font-size: 23rpx;
}

.ride-status {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 99rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.status-seats {
  color: #0b6b58;
  background: #e5f5ef;
}

.status-running {
  color: #a85f37;
  background: #fff3e4;
}

.status-full,
.status-closed {
  color: #71807b;
  background: #eef2f0;
}

.fare {
  color: #a85f37;
  font-size: 23rpx;
  font-weight: 600;
}

.fare text {
  font-size: 21rpx;
  font-weight: 400;
}

.timeline {
  display: flex;
  margin: 34rpx 0 26rpx;
}

.timeline-track {
  position: relative;
  width: 36rpx;
  margin-right: 18rpx;
}

.timeline-dot {
  position: absolute;
  left: 8rpx;
  z-index: 1;
  width: 16rpx;
  height: 16rpx;
  border: 5rpx solid #0b6b58;
  border-radius: 50%;
  background: #ffffff;
}

.dot-start { top: 6rpx; }
.dot-end { bottom: 6rpx; border-color: #e06f3d; }

.timeline-line {
  position: absolute;
  top: 27rpx;
  bottom: 27rpx;
  left: 20rpx;
  width: 2rpx;
  background: #d8e5df;
}

.locations {
  flex: 1;
}

.location-row {
  min-height: 54rpx;
}

.destination-row {
  margin-top: 22rpx;
}

.time {
  width: 100rpx;
  font-size: 25rpx;
  font-weight: 650;
}

.location-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 650;
}

.ride-note {
  padding: 20rpx;
  border-radius: 16rpx;
  color: #52645e;
  background: #f7f9f8;
  font-size: 23rpx;
  line-height: 1.5;
}

.ride-footer {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf2ef;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(145deg, #0b5c4d, #41a283);
  line-height: 68rpx;
  text-align: center;
  font-weight: 700;
}

.avatar-image {
  display: block;
  flex: none;
  background: #e8f4ef;
}

.owner-name {
  font-weight: 650;
}

.ride-date {
  margin-top: 5rpx;
  color: #71807b;
  font-size: 22rpx;
}

.contact-button {
  padding: 0 28rpx;
  color: #ffffff;
  background: #0b5c4d;
}

.load-more-button {
  margin: 22rpx 0 8rpx;
  border: 1rpx solid #b8d8ce;
  color: #075e54;
  background: #ffffff;
  font-size: 24rpx;
}

.empty-icon {
  margin-bottom: 16rpx;
  font-size: 56rpx;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #93a29d;
}

.school-scope {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 99rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.school-scope text {
  color: #9ce2c8;
  font-size: 20rpx;
  font-weight: 500;
}

