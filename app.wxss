page {
  min-height: 100%;
  background: #f4f7f5;
  color: #18332d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.card {
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #e3ebe7;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(13, 73, 60, 0.06);
}

.section-title {
  margin: 38rpx 4rpx 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #18332d;
}

.muted {
  color: #71807b;
}

.primary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0b5c4d 0%, #147a65 100%);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 90rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(11, 92, 77, 0.14);
}

.primary-button::after {
  border: 0;
}

.button-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
  text-align: center;
}

.empty-state {
  padding: 88rpx 40rpx;
  text-align: center;
  color: #71807b;
}

